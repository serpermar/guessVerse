# ---- Backend (copiar a backend/.env y rellenar) ----

# TMDB (películas/series). El backend solo usa TMDB_ACCESS_TOKEN.
TMDB_ACCESS_TOKEN=

# Supabase (proyecto en https://supabase.com)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Servidor
PORT=3000
NODE_ENV=development

# CORS: en producción es OBLIGATORIO. Lista de dominios separados por coma.
# Ejemplo: https://guessverse.vercel.app,http://localhost:5173
# CORS_ORIGINS=
